#!/bin/sh
# xnu-save check|open PARTITION: the hosted iOS's saved changes. The iOS volume at the start of the partition is never written; changes go to
# a persistent dm snapshot in a save area behind it (docs/STORAGE.md), over the RAM snapshot "iosroot" that carries the code patches.
#   check  is there room, and do saved changes belong to this volume? (exit status; a new or reset area is prepared by "open")
#   open   make /dev/mapper/iossaved; XNU uses it as its disk
D=$2
START=41943040		# sectors: 20 GiB into the partition
LENGTH=16777216		# 8 GiB
HEAD=2048		# the first MiB holds our mark, the snapshot's store follows
DM="/dm/ld-linux-aarch64.so.1 --library-path /dm /dm/dmsetup"

number() { dd if="$D" bs=1 skip="$1" count=4 2>/dev/null | od -An -tu1 | awk '{ printf "%.0f", $1 * 16777216 + $2 * 65536 + $3 * 256 + $4 }'; }
# the volume's header (it changes whenever somebody mounts the volume for writing: then the saved changes no longer fit it)
mark() { echo "XNUSAVE1 $(dd if="$D" bs=512 skip=2 count=1 2>/dev/null | sha256sum | cut -d' ' -f1)"; }
stored() { dd if="$D" bs=512 skip=$START count=1 2>/dev/null | tr -d '\0' | head -n 1; }

case "$1" in
check)
	size=$(blockdev --getsz "$D") || exit 1
	volume=$(awk -v b="$(number 1064)" -v n="$(number 1068)" 'BEGIN { printf "%.0f", b / 512 * n }')
	# behind the volume, and clear of the partition's last 4 MiB (the direct port's log)
	if [ "$volume" -le 0 ] || [ "$volume" -gt $START ] || [ $((START + LENGTH + 16384)) -gt "$size" ]; then
		echo "xnu-save: no room (volume $volume, partition $size sectors): changes are not saved"; exit 1
	fi
	old=$(stored)
	case "$old" in
	XNUSAVE1*)
		if [ "$old" != "$(mark)" ] && ! grep -qw xnusavereset /proc/cmdline; then
			echo "xnu-save: the iOS volume changed since the changes were saved: they are not used and not saved now (SAVE=reset discards them)"
			exit 1
		fi ;;
	esac ;;
open)
	if [ "$(stored)" != "$(mark)" ] || grep -qw xnusavereset /proc/cmdline; then
		# an empty store is one that starts with zeroes
		dd if=/dev/zero of="$D" bs=512 seek=$((START + HEAD)) count=2048 conv=notrunc 2>/dev/null &&
		dd if=/dev/zero of="$D" bs=512 seek=$START count=1 conv=notrunc 2>/dev/null &&
		mark | dd of="$D" bs=512 seek=$START count=1 conv=notrunc 2>/dev/null && sync || { echo "xnu-save: cannot prepare the save area"; exit 1; }
		echo "xnu-save: new save area"
	fi
	DM_DISABLE_UDEV=1 $DM create iossave --noudevsync --table "0 $((LENGTH - HEAD)) linear $D $((START + HEAD))" || exit 1
	DM_DISABLE_UDEV=1 $DM create iossaved --noudevsync --table "0 $(blockdev --getsz "$D") snapshot /dev/mapper/iosroot /dev/mapper/iossave P 8" || exit 1
	[ -e /dev/mapper/iossaved ] || { echo "xnu-save: no device"; exit 1; }
	# XNU's writes land in Linux's cache: put them on the storage every few seconds (a forced power-off loses the last moments)
	(while :; do sleep 3; sync; done) > /dev/null 2>&1 < /dev/null &
	echo "xnu-save: changes are saved ($($DM status iossaved | awk '{ print $4 }') sectors used)" ;;
*)
	echo "xnu-save check|open PARTITION"; exit 2 ;;
esac
