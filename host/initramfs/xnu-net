#!/bin/sh
# The hosted system's network (docs/NETWORK.md): xnu0 (fki.ko) is 192.168.77.1/24; dnsmasq gives iOS its address (DHCP) and names (DNS,
# forwarded to the servers of /etc/resolv.conf, which wifi-join's lease fills in); everything else is masqueraded out of Linux's route.
ip link show xnu0 > /dev/null 2>&1 || { echo "xnu-net: no xnu0 (fki.ko not loaded)"; exit 1; }
ip addr replace 192.168.77.1/24 dev xnu0 && ip link set xnu0 up || exit 1
touch /etc/resolv.conf
mkdir -p /var/lib/misc /var/run
pidof dnsmasq > /dev/null || dnsmasq --conf-file=/dev/null --user=root --group=root --interface=xnu0 --bind-interfaces --resolv-file=/etc/resolv.conf \
	--dhcp-authoritative --dhcp-range=192.168.77.10,192.168.77.50,12h --dhcp-option=option:router,192.168.77.1 \
	--dhcp-option=option:dns-server,192.168.77.1 --log-facility=/tmp/dnsmasq.log || exit 1
echo 1 > /proc/sys/net/ipv4/ip_forward
for m in nf_tables nft_ct nft_nat nft_chain_nat nft_masq; do modprobe -q $m; done
nft -f - <<'RULES' || echo "xnu-net: no NAT"
table ip xnu
delete table ip xnu
table ip xnu {
	chain post {
		type nat hook postrouting priority srcnat;
		ip saddr 192.168.77.0/24 oifname != "xnu0" masquerade
	}
}
RULES
echo "xnu-net: xnu0 up"
