#!/bin/sh
# xnu-run [xnu.ko parameters]: load fki.ko and xnu.ko and start the hosted XNU kernel /lib/firmware/xnu/kernel.macho. The kernel log carries XNU's console.
# insmod returns when the run ends, so it runs detached. Defaults: a contiguous region (mode=3), one CPU, 1536 MB
# (above 1 GB XNU uses 16 KB pages), the root disk below.
# XNU boot-args with spaces need literal quotes for the kernel's parameter parser: bootargs="\"a=1 b=2\"".
[ -f /lib/firmware/xnu/kernel.macho ] || { echo "no hosted kernel in this image"; exit 1; }
# XNU's CPUs on the fast cores first (Kryo 360: Linux CPUs 6-7 are the Cortex-A75s, 0-5 the A55s); the host's helpers get the next ones
grep -q '^fki ' /proc/modules || insmod /hosted/fki.ko cpu_list=${XNU_CPU_LIST:-6,7,5,4,3,2,1,0} || exit 1
# the GPU bridge (docs/GPU-BRIDGE.md): adrenod serves the hosted system's GPU requests on Linux's render node. XNU_GPU=0 leaves it out.
G=
if [ "${XNU_GPU:-1}" = 1 ] && [ -c /dev/dri/renderD128 ]; then
	pidof adrenod > /dev/null || setsid adrenod ${ADRENOD_V:--v} > /tmp/adrenod.log 2>&1 < /dev/null &
	G="gpu_pool_mb=${XNU_GPU_POOL:-384}"
	GPUARGS="sweetmtl=2 sweetgpureserve=16${XNU_MESALOG:+ sweetmesalog=1}"
fi
# the iOS root: the direct port's HFS+ image on userdata. That volume is the fallback port's and is never written: XNU gets a snapshot of it
# whose changes go to a file in RAM (gone at reboot), or with xnusave also to a save area behind the volume. XNU_DISK= another partition.
D=${XNU_DISK-/dev/mmcblk0p72}
H=$(dd if="$D" bs=1 skip=1024 count=2 2>/dev/null)
DISK=
DM="/dm/ld-linux-aarch64.so.1 --library-path /dm /dm/dmsetup"
# saved changes (boot-arg xnusave, set by host/boot-ios.sh; xnusavereset starts them anew): see host/initramfs/xnu-save
SAVE=
grep -qw xnusave /proc/cmdline && SAVE=1
[ -n "${XNU_SAVE+x}" ] && SAVE=$XNU_SAVE
if [ "$H" = "H+" ] || [ "$H" = "HX" ]; then
	if [ ! -e /dev/mapper/iosroot ]; then
		modprobe -q dm-mod; modprobe -q dm-snapshot
		N=$(blockdev --getsz "$D")
		if [ "$SAVE" = 1 ] && ! xnu-save check "$D"; then SAVE=; fi
		if [ "$SAVE" = 1 ]; then
			# the partition stays writable for the save area; the iOS volume is reached only through a read-only mapping
			DM_DISABLE_UDEV=1 $DM create iosbase --readonly --noudevsync --table "0 $N linear $D 0" || exit 1
			B=/dev/mapper/iosbase
		else
			blockdev --setro "$D" || exit 1
			B=$D
		fi
		mkdir -p /cow && mount -t tmpfs -o size=512m cow /cow && truncate -s 524288000 /cow/iosroot && losetup /dev/loop0 /cow/iosroot || exit 1
		DM_DISABLE_UDEV=1 $DM create iosroot --noudevsync --table "0 $N snapshot $B /dev/loop0 N 8" || exit 1
		[ -e /dev/mapper/iosroot ] || { echo "no snapshot device"; exit 1; }
		# patches to iOS's code, into the snapshot in RAM, before XNU reads it (never into the saved changes). XNU_PATCH=0 leaves iOS as it is.
		[ "${XNU_PATCH:-1}" = 1 ] && [ -f /etc/iospatch.list ] && iospatch /dev/mapper/iosroot /etc/iospatch.list
		[ "$SAVE" = 1 ] && { xnu-save open "$D" || exit 1; }
		# XNU_PRESTART=script (tests): changes the root disk (its argument) before XNU reads it
		[ -n "$XNU_PRESTART" ] && { sh "$XNU_PRESTART" /dev/mapper/iosroot || exit 1; }
	fi
	if [ -e /dev/mapper/iossaved ]; then DISK="hostdisk=/dev/mapper/iossaved hostdisk_rw=1"; else DISK="hostdisk=/dev/mapper/iosroot hostdisk_rw=1"; fi
else
	echo "$D has no HFS+ volume"
fi
# the network: en0 on the host's xnu0 (xnu-net gives it DHCP, DNS and NAT). XNU_NET=0 leaves it out.
NET=
[ "${XNU_NET:-1}" = 1 ] && command -v xnu-net > /dev/null && NET="linux64net=1"
# XNU_WIFI=1 (the default): en0 is iOS's Wi-Fi: Settings lists the networks the host's radio hears and joins them (wifihost). =fake: made-up networks.
SVC=
: ${XNU_WIFI=1}	# XNU_WIFI= (empty): en0 stays a wired interface
command -v wifihost > /dev/null || XNU_WIFI=
if [ -n "$NET" ] && [ -n "$XNU_WIFI" ]; then
	NET="$NET linux64wifi=1"
	: > /tmp/xnusvc.out; : > /tmp/xnusvc.in
	SVC="wlan=1 svc_out=/tmp/xnusvc.out svc_in=/tmp/xnusvc.in"
	F_WIFI=
	[ "$XNU_WIFI" = fake ] && F_WIFI=1
	WIFIHOST_FAKE=$F_WIFI setsid wifihost /tmp/xnusvc.out /tmp/xnusvc.in > /tmp/wifihost.log 2>&1 < /dev/null &
fi
# the battery iOS shows is the phone's (xnu-state keeps /tmp/xnustate current)
STATE=
command -v xnu-state > /dev/null && { pidof xnu-state > /dev/null || setsid xnu-state /tmp/xnustate > /dev/null 2>&1 < /dev/null & sleep 1; STATE="state_in=/tmp/xnustate"; }
# brightness: iOS's slider sets the panel (host/initramfs/xnu-bright follows the kernel log)
command -v xnu-bright > /dev/null && { pidof xnu-bright > /dev/null || setsid xnu-bright > /tmp/xnu-bright.log 2>&1 < /dev/null & }
# shut down and restart from iOS (host/initramfs/xnu-halt)
command -v xnu-halt > /dev/null && { pidof xnu-halt > /dev/null || setsid xnu-halt > /tmp/xnu-halt.log 2>&1 < /dev/null & }
# the cameras (docs/CAMERA.md): the server switches one on while iOS's camera app asks for frames. XNU_CAMERA=0 leaves them out.
CAM=
if [ "${XNU_CAMERA:-1}" = 1 ] && command -v camcap > /dev/null && cam-up > /tmp/cam-up.log 2>&1; then
	: >> /tmp/xnucam
	pidof camcap > /dev/null || setsid camcap serve /tmp/xnucam > /tmp/camcap.log 2>&1 < /dev/null &
	CAM="cam=/tmp/xnucam"
fi
# touch and buttons: Linux's input events, relayed into a file xnu.ko reads
: > /tmp/xnuinput
pidof evrelay > /dev/null || setsid evrelay /tmp/xnuinput > /tmp/evrelay.log 2>&1 < /dev/null &
# (XNU_DENY=words: sweetdeny. A long list of crashing daemons got launchd killed at boot, 2026-11-27: not a default)
# boot-args the direct port's userland needs (bonito/tools/mkios.sh), without its hardware ones
A="${NET:+$NET }${GPUARGS:+$GPUARGS }cpus=${XNU_CPUS:-4} keepsyms=1 rootrw=1 sweetfb_native=1 sweetfb_noconsole=1 wdt=-1 unentitled_ios_sim_launch=1 ignition_level=1 wdt_test=no_user_checkin launchd_unsecure_cache=1 sweethide=com.apple.MobileGestalt.plist ${XNU_DENY:+sweetdeny=$XNU_DENY }sweetargs=SpringBoard,UIStatusBarVisualProviderClassName,_UIStatusBarVisualProvider_Split1080"
# the hosted display: a framebuffer in XNU's memory, copied to the host's fb0 (the text console lets go of it first)
for v in /sys/class/vtconsole/vtcon*; do grep -q "frame buffer" $v/name 2>/dev/null && echo 0 > $v/bind; done
F=
# kmsfb scans XNU's framebuffer out directly (XNU draws the frame counter). XNU_DISPLAY=copy: the old path, xnu.ko writes each frame to a
# file in RAM (Linux's fbdev has no write path for kernel buffers) and fbcopy shows it. With kmsfb the file is for screenshots only.
FBARGS=
if [ -c /dev/fb0 ]; then
	: > /tmp/xnufb
	if [ "${XNU_DISPLAY:-kms}" = kms ] && command -v kmsfb > /dev/null; then
		F="fb_width=1080 fb_height=2160 fb_dump=/tmp/xnufb fb_dump_ms=1000"
		FBARGS="sweetfb_hz=60 sweetfb_fps=1"
	else
		F="fb_width=1080 fb_height=2160 fb_dump=/tmp/xnufb fb_dump_ms=33"
		pidof fbcopy > /dev/null || setsid fbcopy /tmp/xnufb > /dev/null 2>&1 < /dev/null &
	fi
fi
A="${FBARGS:+$FBARGS }$A"
# XNU_BOOTARGS first: the first occurrence of a boot-arg counts. All of XNU's boot-args have 608 bytes (xnu.ko refuses more).
A="${XNU_BOOTARGS:+$XNU_BOOTARGS }$A"
# XNU's memory is one contiguous block, which Linux cannot always put together (seen after much file traffic): then again with the caches
# dropped, and with less. XNU_RAM=MB: that size only. (insmod stays for the whole run: a failure shows within seconds.)
ok=
for M in ${XNU_RAM:-1408 1408 1216 1088}; do
	setsid insmod /hosted/xnu.ko $F $G $SVC $STATE $CAM input_in=/tmp/xnuinput image=xnu/kernel.macho adtprops=xnu/adtprops.bin model=iPhone10,3 mode=3 cpus=${XNU_CPUS:-4} ram_mb=$M monitor_cpu=0 $DISK bootargs="\"$A\"" "$@" > /tmp/xnu-insmod.log 2>&1 < /dev/null &
	for i in 1 2 3 4 5 6; do sleep 1; grep -q 'Cannot allocate memory' /tmp/xnu-insmod.log && break; done
	grep -q 'Cannot allocate memory' /tmp/xnu-insmod.log || { grep -q "can't insert" /tmp/xnu-insmod.log || ok=1; break; }
	echo "no room for ${M} MB"
	sync; echo 3 > /proc/sys/vm/drop_caches; echo 1 > /proc/sys/vm/compact_memory
done
[ -n "$ok" ] || { echo "XNU was not started (/tmp/xnu-insmod.log, dmesg)"; exit 1; }
[ -n "$FBARGS" ] && { pidof kmsfb > /dev/null || setsid kmsfb > /tmp/kmsfb.log 2>&1 < /dev/null & }
echo started
