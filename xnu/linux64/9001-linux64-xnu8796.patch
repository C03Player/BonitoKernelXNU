+	 * x1: JOP off for this thread (arm64, not arm64e): EnIA (31) and EnDA (27) off at EL0. Only after the last
+	 * kernel pointer authentication (LOAD_KERN_STACK_TOP authenticates; with EnDA off it would trap to brk).
+	 */
+	cbz		x1, 1f
+	mrs		x10, SCTLR_EL1
+	mov		x11, #((1 << 31) | (1 << 27))
+	bic		x10, x10, x11
+	msr		SCTLR_EL1, x10
+1:
+	isb
+	add		x30, x0, SS64_X0
+	ldp		x2, x3, [x30, #16]
+	ldp		x4, x5, [x30, #32]
+	ldp		x6, x7, [x30, #48]
+	ldp		x8, x9, [x30, #64]
+	ldp		x10, x11, [x30, #80]
+	ldp		x12, x13, [x30, #96]
+	ldp		x14, x15, [x30, #112]
+	ldp		x16, x17, [x30, #128]
+	ldp		x18, x19, [x30, #144]
+	ldp		x20, x21, [x30, #160]
+	ldp		x22, x23, [x30, #176]
+	ldp		x24, x25, [x30, #192]
+	ldp		x26, x27, [x30, #208]
+	ldp		x28, x29, [x30, #224]
+	ldp		x0, x1, [x30, #0]
+	ldr		x30, [x30, #240]
+	eret
