+ * LINUX64 (xnulinux): user space while hosted. linux64_el0_run(ss) enters EL0 with the user state in ss
+ * (IRQs stay masked at EL0), on this CPU, with VBAR_EL1 pointing at linux64_el0_vectors and SP_EL0 holding the
+ * user sp. What the kernels need back on the next exception from EL0 (XNU's thread pointer, which TPIDRRO_EL0 holds in
+ * the kernel and the user's TSD at EL0; Linux's vectors, its `current` in SP_EL0, its shadow call stack in x18 and
+ * SCTLR_EL1) goes in a block at the top of the thread's kernel stack, where SP_EL1 points at that exception: per thread,
+ * so per CPU. The exception builds a register frame below it, puts all that back and calls
+ * linux64_el0_exception(frame) (sleh.c), which hands it to sleh_synchronous and returns to user space again.
+ */
+#define LINUX64_EL0_BLOCK	64		// thread, SP_EL0, VBAR_EL1, x18, SCTLR_EL1
+#define LINUX64_EL0_FRAME	(36 * 8 + 528)	// struct linux64_el0_frame (sleh.c)
+
+	.text
+	.align 2
+	.globl EXT(linux64_el0_run)
+LEXT(linux64_el0_run)
+	mrs		x11, TPIDRRO_EL0						// this CPU's thread
+	ldr		x12, [x11, TH_KSTACKPTR]			// top of the kernel stack (the context switch save area sits there)
+	sub		x15, x12, #LINUX64_EL0_BLOCK
+	str		x11, [x15, #0]
+	mrs		x10, SP_EL0
+	str		x10, [x15, #8]
+	mrs		x10, VBAR_EL1
+	str		x10, [x15, #16]
+	str		x18, [x15, #24]
+	mrs		x10, SCTLR_EL1
+	str		x10, [x15, #32]
+	adrp	x10, EXT(linux64_el0_vectors)@page
+	add		x10, x10, EXT(linux64_el0_vectors)@pageoff
+	msr		VBAR_EL1, x10
+	ldr		x10, [x0, SS64_SP]
+	msr		SP_EL0, x10
+	ldr		x10, [x0, SS64_PC]
+	msr		ELR_EL1, x10
+	ldr		w10, [x0, SS64_CPSR]
+	orr		w10, w10, #0x40						// FIQ stays masked at EL0 while hosted; a (Linux) IRQ preempts user code
+	msr		SPSR_EL1, x10
+	// the user's NEON/FP state (arm_context_t ns, right after ss): upcalls may let Linux schedule, which reuses the registers
+	add		x9, x0, NS64_Q0
+	ldp		q0, q1, [x9, #0]
+	ldp		q2, q3, [x9, #32]
+	ldp		q4, q5, [x9, #64]
+	ldp		q6, q7, [x9, #96]
+	ldp		q8, q9, [x9, #128]
+	ldp		q10, q11, [x9, #160]
+	ldp		q12, q13, [x9, #192]
+	ldp		q14, q15, [x9, #224]
+	ldp		q16, q17, [x9, #256]
+	ldp		q18, q19, [x9, #288]
+	ldp		q20, q21, [x9, #320]
+	ldp		q22, q23, [x9, #352]
+	ldp		q24, q25, [x9, #384]
+	ldp		q26, q27, [x9, #416]
+	ldp		q28, q29, [x9, #448]
+	ldp		q30, q31, [x9, #480]
+	ldr		w10, [x9, #512]
+	msr		FPSR, x10
+	ldr		w10, [x9, #516]
+	msr		FPCR, x10
+	mov		sp, x15								// the next exception from EL0 starts below the block
+	ldr		x10, [x11, TH_CTH_SELF]				// the user's TSD (Darwin reads it from TPIDRRO_EL0)
+	msr		TPIDRRO_EL0, x10
