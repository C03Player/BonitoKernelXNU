diff --git a/libkern/crypto/corecrypto_rand.c b/libkern/crypto/corecrypto_rand.c
index d46815b..acea296 100644
--- a/libkern/crypto/corecrypto_rand.c
+++ b/libkern/crypto/corecrypto_rand.c
@@ -27,9 +27,19 @@
  */
 
 #include <libkern/crypto/crypto_internal.h>
+#include <linux64/linux64.h>
 #include <corecrypto/ccrng.h>
+#include <string.h>
 #include <libkern/crypto/rand.h>
 
+/*
+ * LINUX64 (xnulinux): until the corecrypto kext registers g_crypto_funcs (and on a hosted kernel without it), random
+ * bytes come from the host's generator (Linux's get_random_bytes, LINUX64_CALL_RANDOM). A context made before then
+ * holds nothing (linux64_rng_ctx_size).
+ */
+#define linux64_rng_fallback()  (g_crypto_funcs == NULL && linux64_hook != 0)
+#define linux64_rng_ctx_size    (2 * sizeof(uint64_t))
+
 int
 cc_rand_generate(void *out, size_t outlen)
 {
@@ -41,6 +51,9 @@ cc_rand_generate(void *out, size_t outlen)
 		if (rng_state != NULL) {
 			error = ccrng_generate(rng_state, outlen, out);
 		}
+	} else if (linux64_rng_fallback()) {
+		linux64_random(out, outlen);
+		error = 0;
 	}
 
 	return error;
@@ -58,6 +71,10 @@ crypto_random_generate(
 	void *random,
 	size_t random_size)
 {
+	if (linux64_rng_fallback()) {
+		linux64_random(random, random_size);
+		return;
+	}
 	g_crypto_funcs->random_generate_fn(ctx, random, random_size);
 }
 
@@ -67,12 +84,19 @@ crypto_random_uniform(
 	uint64_t bound,
 	uint64_t *random)
 {
+	if (linux64_rng_fallback()) {
+		*random = linux64_random_uniform(bound);
+		return;
+	}
 	g_crypto_funcs->random_uniform_fn(ctx, bound, random);
 }
 
 size_t
 crypto_random_kmem_ctx_size(void)
 {
+	if (linux64_rng_fallback()) {
+		return linux64_rng_ctx_size;
+	}
 	return g_crypto_funcs->random_kmem_ctx_size_fn();
 }
 
@@ -80,5 +104,9 @@ void
 crypto_random_kmem_init(
 	crypto_random_ctx_t ctx)
 {
+	if (linux64_rng_fallback()) {
+		memset(ctx, 0, linux64_rng_ctx_size);
+		return;
+	}
 	g_crypto_funcs->random_kmem_init_fn(ctx);
 }
diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index c6e2d70..dbd24e6 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -60,7 +60,8 @@ MACHINE_FLAGS_ARM64_T8101 = -DARM64_BOARD_CONFIG_T8101			-mcpu=apple-a14
 MACHINE_FLAGS_ARM64_T8103 = -DARM64_BOARD_CONFIG_T8103                  -mcpu=apple-a14
 MACHINE_FLAGS_ARM64_T6000 = -DARM64_BOARD_CONFIG_T6000 		-mcpu=apple-a14
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a
-MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
+# LINUX64 (hosted on Kryo 360): name the CPU, or Apple clang emits instructions of its default Apple core
+MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837             -mcpu=cortex-a55+crypto
 # The CPU, not just the architecture: with -arch arm64 Apple clang's default CPU is an Apple core,
 # and -march=armv8.2-a+crypto kept its features, so clang vectorized XORs into EOR3 (FEAT_SHA3),
 # an undefined instruction on the A76/A55 (panic in a6_blit_ib). Cortex-A55 = the ISA both clusters share.
@@ -340,6 +341,14 @@ ARM64_PLKSEG_ADDR  =0xfffffe0004004000
 ARM64_LINK_ADDR    =0xfffffe0007004000
 endif
 
+# LINUX64: hosted, the kernel lives in the top 512 GiB slot of Linux's 4 KB-granule tables (xnu.ko installs its level-1
+# entries there): the small kernel address layout, 0xffffffe000000000 up, also for this MacOSX-platform build
+ifeq ($(CURRENT_MACHINE_CONFIG),SWEET)
+LARGE_MEMORY_DEFINE=-UARM_LARGE_MEMORY
+ARM64_PLKSEG_ADDR  =0xfffffff004004000
+ARM64_LINK_ADDR    =0xfffffff007004000
+endif
+
 
 CFLAGS_ARM64	= -Darm64 -DARM64 -D__ARM64__ -DLP64 -DPAGE_SIZE_FIXED -DVM_KERNEL_LINK_ADDRESS=$(ARM64_LINK_ADDR) \
 			$(LARGE_MEMORY_DEFINE) -momit-leaf-frame-pointer -fno-strict-aliasing -D__API__=v4 -mkernel
diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index 42362c5..316c79b 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -30,6 +30,7 @@
  */
 
 #include <debug.h>
+#include <linux64/linux64.h>
 #include <mach_ldebug.h>
 #include <mach_kdp.h>
 
@@ -210,6 +211,13 @@ extern vm_offset_t segLOWESTKC, segHIGHESTKC, segLOWESTROKC, segHIGHESTROKC;
 extern vm_offset_t segLOWESTAuxKC, segHIGHESTAuxKC, segLOWESTROAuxKC, segHIGHESTROAuxKC;
 extern vm_offset_t segLOWESTRXAuxKC, segHIGHESTRXAuxKC, segHIGHESTNLEAuxKC;
 
+/* LINUX64 (xnulinux): the hosted machine layer's state (linux64/linux64.h), set by xnu.ko before arm_init */
+uintptr_t linux64_hook;
+uintptr_t linux64_slide;
+unsigned int linux64_vint[LINUX64_CPU_SLOTS];
+unsigned int linux64_ipi_pending[LINUX64_CPU_SLOTS];
+unsigned long linux64_dbg[LINUX64_NCOUNTERS];
+
 static void
 arm_slide_rebase_and_sign_image(void)
 {
@@ -267,10 +275,14 @@ arm_slide_rebase_and_sign_image(void)
 		 * using hardcoded kernel link address
 		 */
 		slide = (uintptr_t)k_mh - VM_KERNEL_LINK_ADDRESS;
+		if (linux64_hook) {
+			/* LINUX64: xnu.ko loaded, slid (load commands too) and signed the image already. */
+			slide = linux64_slide;
+		}
 
 		/* rebase and sign jops */
 		static_kernelcache = &__thread_starts_sect_end[0] != &__thread_starts_sect_start[0];
-		if (static_kernelcache) {
+		if (static_kernelcache && !linux64_hook) {
 			rebase_threaded_starts( &__thread_starts_sect_start[0],
 			    &__thread_starts_sect_end[0],
 			    (uintptr_t)k_mh, (uintptr_t)k_mh - slide, slide);
@@ -335,6 +347,28 @@ arm_setup_pre_sign(void)
  *		Function:		Runs on the boot CPU, once, on entry from iBoot.
  */
 
+/*
+ * LINUX64 (xnulinux): where a secondary CPU starts (LINUX64_CALL_CPU_START), on the host's thread for that CPU, in
+ * its own world (the host's page tables, which hold XNU's kernel mappings; XNU's keys). start_cpu's work on hardware
+ * (MMU, vectors, stacks) is the host's; arm_init_cpu sets the thread pointer and goes on into the scheduler.
+ */
+void arm_init_cpu(cpu_data_t *cpu_data_ptr);
+void linux64_cpu_entry(cpu_data_t *cpu_data_ptr) __attribute__((noreturn));
+void
+linux64_cpu_entry(cpu_data_t *cpu_data_ptr)
+{
+	arm_init_cpu(cpu_data_ptr);
+	__builtin_unreachable();
+}
+
+/* LINUX64: a failed assert() while hosted (see kern/assert.h); the host may end the run. */
+void
+linux64_assert_report(const char *file, int line, const char *expr)
+{
+	struct linux64_assert_info a = { file, line, expr };
+	linux64_call(LINUX64_CALL_ASSERT, &a);
+}
+
 __startup_func
 void
 arm_init(
diff --git a/osfmk/arm/cpu_data.h b/osfmk/arm/cpu_data.h
index 60c931a..a9c9de7 100644
--- a/osfmk/arm/cpu_data.h
+++ b/osfmk/arm/cpu_data.h
@@ -59,8 +59,9 @@ current_thread_fast(void)
 	 *
 	 * and ignores the "attribute const", so do it the "dumb" way.
 	 */
+	/* LINUX64 (xnulinux): TPIDR_EL1 belongs to Linux; XNU's kernel keeps its thread pointer in TPIDRRO_EL0 */
 	unsigned long result;
-	__asm__ ("mrs %0, TPIDR_EL1" : "=r" (result));
+	__asm__ ("mrs %0, TPIDRRO_EL0" : "=r" (result));
 	return __unsafe_forge_single(thread_t, result);
 #else
 	// TPIDRPRW
@@ -95,7 +96,7 @@ current_thread_volatile(void)
 	 */
 #if defined(__arm64__)
 	unsigned long result;
-	__asm__ volatile ("mrs %0, TPIDR_EL1" : "=r" (result));
+	__asm__ volatile ("mrs %0, TPIDRRO_EL0" : "=r" (result));	/* LINUX64: see current_thread_fast */
 	return __unsafe_forge_single(thread_t, result);
 #else
 	// TPIDRPRW
@@ -108,7 +109,16 @@ current_thread_volatile(void)
 static inline vm_offset_t
 exception_stack_pointer(void)
 {
-	vm_offset_t result = 0;
+	vm_offset_t result = 0, spsel;
+	/*
+	 * LINUX64 (xnulinux): hosted XNU runs on Linux's SP_EL1 stack, and SP_EL0 is
