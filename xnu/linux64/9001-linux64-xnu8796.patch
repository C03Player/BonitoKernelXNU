+ */
+uint64_t linux64_kernel_fault_recover(uint64_t pc, uint64_t far, uint64_t esr);
+uint64_t
+linux64_kernel_fault_recover(uint64_t pc, uint64_t far, uint64_t esr)
+{
+	struct copyio_recovery_entry *e = NULL;
+	ptrdiff_t offset = copyio_recovery_offset(pc);
+	for (struct copyio_recovery_entry *c = copyio_recover_table; c < copyio_recover_table_end; c++) {
+		if (offset >= c->cre_start && offset < c->cre_end) {
+			e = c;
+			break;
+		}
+	}
+	thread_t thread = current_thread();
