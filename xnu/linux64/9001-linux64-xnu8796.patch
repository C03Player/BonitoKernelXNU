+		buf_setcount(bp, (uint32_t)(((uint64_t)mdev[devid].mdSize << 12) - blkoff));  /* Yes, trim to max */
 	}
 	/*
 	 * make sure the buffer's data area is
@@ -304,6 +365,18 @@ mdevstrategy(struct buf *bp)
 		panic("ramstrategy: buf_map failed");
 	}
 
+	if (mdev[devid].mdFlags & mdHost) {                      /* LINUX64 (xnulinux): host-file disk */
