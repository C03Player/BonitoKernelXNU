+	linux64_el0_run(thread->machine.upcb, (thread->machine.arm_machine_flags & ARM_MACHINE_THREAD_DISABLE_USER_JOP) != 0);
+#else
+	linux64_el0_run(thread->machine.upcb, false);	/* no pointer authentication on this CPU: nothing to switch off */
+#endif
