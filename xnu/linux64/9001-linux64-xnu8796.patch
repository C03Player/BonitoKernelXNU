 static LCK_GRP_DECLARE(sweet_pmem_grp, "sweet_pmem");
 static LCK_MTX_DECLARE(sweet_pmem_lock, &sweet_pmem_grp);
diff --git a/bsd/kern/linux64_host.c b/bsd/kern/linux64_host.c
new file mode 100644
index 0000000..00cb495
--- /dev/null
+++ b/bsd/kern/linux64_host.c
@@ -0,0 +1,124 @@
+/*
+ * Copyright (c) 2026 xnulinux contributors. All rights reserved.
+ *
+ * @APPLE_OSREFERENCE_LICENSE_HEADER_START@
+ * This file contains Original Code and/or Modifications of Original Code as defined in and that are subject to the Apple
+ * Public Source License Version 2.0 (the 'License'). You may not use this file except in compliance with the License.
+ * @APPLE_OSREFERENCE_LICENSE_HEADER_END@
+ */
+/*
+ * LINUX64 (xnulinux): the host's devices for the hosted system's drivers (kexts/), as kernel functions they import.
+ * Each is one call into the host (linux64/linux64_abi.h); off the host they do nothing.
+ *
+ *   XnuEthernet  linux64_net_send, linux64_net_recv    frames through the Linux netdev xnu0 (Linux routes and NATs)
+ *   XnuInput     linux64_input_read                    evdev records from the host
+ *   XnuEAN       linux64_store_rw                      the keystore file
+ *   XnuDisk      linux64_disk_size, linux64_disk_rw    the system disk
+ *   XnuDrm       linux64_hostcall                      messages to a Linux service (the GPU bridge, xnudrmd)
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <net/ethernet.h>
+#include <linux64/linux64.h>
+
+#define L64_FRAME_MAX   (ETHER_MAX_LEN + 64)
+#define L64_ENXIO       6       /* Linux's ENXIO: the host has no such device */
+
+/* One frame to the host: its length when sent, 0 when not. */
+long linux64_net_send(const void *frame, unsigned long length);
+long
+linux64_net_send(const void *frame, unsigned long length)
+{
+	struct linux64_buf_req q = { .buf = (void *)(uintptr_t)frame, .len = length, .result = 0 };
+
+	if (linux64_hook == 0 || length < ETHER_HDR_LEN || length > L64_FRAME_MAX) {
+		return 0;
+	}
+	linux64_call(LINUX64_CALL_NET_SEND, &q);
+	return q.result > 0 ? (long)length : 0;
+}
+
+/* The next frame from the host into buffer: its length, 0 when none waits. */
+long linux64_net_recv(void *buffer, unsigned long size);
+long
+linux64_net_recv(void *buffer, unsigned long size)
+{
+	struct linux64_buf_req q = { .buf = buffer, .len = size, .result = 0 };
+
+	if (linux64_hook == 0) {
+		return 0;
+	}
+	linux64_call(LINUX64_CALL_NET_RECV, &q);
+	return q.result > 0 ? q.result : 0;
+}
+
+/* Whole struct linux64_input_event records into buffer: their bytes, 0 when none wait. */
+long linux64_input_read(void *buffer, unsigned long size);
+long
+linux64_input_read(void *buffer, unsigned long size)
+{
+	struct linux64_buf_req q = { .buf = buffer, .len = size, .result = 0 };
+
+	if (linux64_hook == 0) {
+		return 0;
+	}
+	linux64_call(LINUX64_CALL_INPUT_READ, &q);
+	return q.result > 0 ? q.result : 0;
+}
+
+static long
+linux64_rw(enum linux64_call call, int write, void *buffer, unsigned long length, unsigned long offset)
+{
+	struct linux64_rw_req q = { .write = (uint64_t)write, .off = offset, .len = length, .buf = buffer, .result = -L64_ENXIO };
+
+	if (linux64_hook == 0) {
+		return -L64_ENXIO;
+	}
+	linux64_call(call, &q);
+	return q.result;
+}
+
+/* The keystore file: `length` bytes at `offset`; bytes moved, or a negative errno. */
+long linux64_store_rw(int write, void *buffer, unsigned long length, unsigned long offset);
+long
+linux64_store_rw(int write, void *buffer, unsigned long length, unsigned long offset)
+{
+	return linux64_rw(LINUX64_CALL_KEYSTORE_RW, write, buffer, length, offset);
+}
+
+/* The system disk: its size in bytes (0: none), and `length` bytes at `offset` (bytes moved, or a negative errno). */
+uint64_t linux64_disk_size(void);
+uint64_t
+linux64_disk_size(void)
+{
+	uint64_t size = 0;
+
+	if (linux64_hook != 0) {
+		linux64_call(LINUX64_CALL_DISK_SIZE, &size);
+	}
+	return size;
+}
+
+long linux64_disk_rw(int write, void *buffer, unsigned long length, unsigned long offset);
+long
+linux64_disk_rw(int write, void *buffer, unsigned long length, unsigned long offset)
+{
+	return linux64_rw(LINUX64_CALL_DISK_RW, write, buffer, length, offset);
+}
+
+/*
+ * A host call: len bytes at req to a Linux service, its reply into reply (at most max bytes). The reply's length, or a
+ * negative errno. The CPU waits in the call.
+ */
