 #include <miscfs/devfs/devfs.h>
 
@@ -172,6 +174,7 @@ struct mdev {
 #define mdInited        0x01    /* This device defined */
 #define mdRO            0x02    /* This device is read-only */
 #define mdPhys          0x04    /* This device is in physical memory */
+#define mdHost          0x08    /* LINUX64 (xnulinux): backed by a host file, I/O through the host */
 
 int mdevBMajor = -1;
 int mdevCMajor = -1;
@@ -180,6 +183,38 @@ static int      mdevioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct
 dev_t           mdevadd(int devid, uint64_t base, unsigned int size, int phys);
 dev_t           mdevlookup(int devid);
 void            mdevremoveall(void);
+dev_t           mdevadd_host(void);
+
+/*
+ * LINUX64 (xnulinux): a hosted XNU's disk backed by a host file. Stage 995 returns its size in bytes (0: none),
+ * stage 994 moves bytes between it and a wired kernel buffer (returns the count or -errno).
+ */
+struct mdev_host_req { uint64_t write, off, len; void *buf; long result; };	/* the hook itself must return 0 */
+
+static long
+mdev_host_call(unsigned long stage, unsigned long arg)
+{
+	register unsigned long x0 __asm__("x0") = stage;
+	register unsigned long x1 __asm__("x1") = arg;
+	register unsigned long x2 __asm__("x2") = 0;
+	__asm__ volatile ("blr %3" : "+r"(x0), "+r"(x1), "+r"(x2) : "r"(linux64_hook)
+	    : "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	    "x14", "x15", "x16", "x17", "x30", "cc", "memory");
+	return (long)x0;
+}
+
+static int
+mdev_host_io(int write, uint64_t off, void *buf, uint64_t len)
+{
+	struct mdev_host_req q = { .write = (uint64_t)write, .off = off, .len = len, .buf = buf, .result = -EIO };
+	long r;
+	mdev_host_call(994, (unsigned long)&q);
+	r = q.result;
+	if (r < 0) {
+		return (int)-r;
+	}
+	return (uint64_t)r == len ? 0 : EIO;
+}
 int             mdevgetrange(int devid, uint64_t *base, uint64_t *size);
 
 static  int
@@ -228,6 +263,32 @@ mdevrw(dev_t dev, struct uio *uio, __unused int ioflag)
