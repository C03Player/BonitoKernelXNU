+	.text
+	.align 11
+	.globl EXT(linux64_el0_vectors)
+LEXT(linux64_el0_vectors)
+	.rept 8										// current EL (SP0, SPx): not expected while at EL0
+	b		Llinux64_el0_bad
+	.align 7
+	.endr
+	b		Llinux64_el0_entry						// lower EL, AArch64: sync
+	.align 7
+	b		Llinux64_el0_irq						// IRQ: the host's interrupt arrived while user code ran
+	.align 7
+	.rept 2										// FIQ, SError
+	b		Llinux64_el0_entry
+	.align 7
+	.endr
+	.rept 4										// lower EL, AArch32
+	b		.
+	.align 7
+	.endr
+
+Llinux64_el0_bad:								// note it for the monitor (linux64_dbg[14] = ESR) and stop here
+	adrp	x9, _linux64_dbg@PAGE
+	add		x9, x9, _linux64_dbg@PAGEOFF
+	mrs		x10, ESR_EL1
+	str		x10, [x9, #112]
+	b		.
+
+Llinux64_el0_irq:								// as an exception, with ESR = ~0 (LINUX64_EL0_ESR_IRQ: no ESR has bits 63:32 set)
+	sub		sp, sp, #LINUX64_EL0_FRAME
+	stp		x0, x1, [sp, #0]
+	mov		x1, #1
+	b		Llinux64_el0_common
+Llinux64_el0_entry:
+	sub		sp, sp, #LINUX64_EL0_FRAME
+	stp		x0, x1, [sp, #0]
+	mov		x1, #0
+Llinux64_el0_common:
+	stp		x2, x3, [sp, #16]
+	stp		x4, x5, [sp, #32]
+	stp		x6, x7, [sp, #48]
+	stp		x8, x9, [sp, #64]
+	stp		x10, x11, [sp, #80]
+	stp		x12, x13, [sp, #96]
+	stp		x14, x15, [sp, #112]
+	stp		x16, x17, [sp, #128]
+	stp		x18, x19, [sp, #144]
+	stp		x20, x21, [sp, #160]
+	stp		x22, x23, [sp, #176]
+	stp		x24, x25, [sp, #192]
+	stp		x26, x27, [sp, #208]
+	stp		x28, x29, [sp, #224]
+	str		x30, [sp, #240]
+	mrs		x0, SP_EL0
+	str		x0, [sp, #248]
+	mrs		x0, ELR_EL1
+	str		x0, [sp, #256]
+	mrs		x0, SPSR_EL1
+	str		x0, [sp, #264]
+	mrs		x0, ESR_EL1
+	cbz		x1, 1f
+	mov		x0, #-1
+1:
+	str		x0, [sp, #272]
+	mrs		x0, FAR_EL1
+	str		x0, [sp, #280]
+	add		x9, sp, #288						// the user's NEON/FP registers (linux64_el0_exception keeps them in uNeon)
+	stp		q0, q1, [x9, #0]
+	stp		q2, q3, [x9, #32]
+	stp		q4, q5, [x9, #64]
+	stp		q6, q7, [x9, #96]
+	stp		q8, q9, [x9, #128]
+	stp		q10, q11, [x9, #160]
+	stp		q12, q13, [x9, #192]
+	stp		q14, q15, [x9, #224]
+	stp		q16, q17, [x9, #256]
+	stp		q18, q19, [x9, #288]
+	stp		q20, q21, [x9, #320]
+	stp		q22, q23, [x9, #352]
+	stp		q24, q25, [x9, #384]
+	stp		q26, q27, [x9, #416]
+	stp		q28, q29, [x9, #448]
+	stp		q30, q31, [x9, #480]
+	mrs		x10, FPSR
+	str		w10, [x9, #512]
+	mrs		x10, FPCR
+	str		w10, [x9, #516]
+	add		x9, sp, #LINUX64_EL0_FRAME			// linux64_el0_run's block
+	ldr		x10, [x9, #0]
+	msr		TPIDRRO_EL0, x10					// XNU's thread pointer again
+	ldr		x10, [x9, #8]
+	msr		SP_EL0, x10
+	ldr		x10, [x9, #16]
+	msr		VBAR_EL1, x10
+	ldr		x18, [x9, #24]						// the host's x18 again (user code owns x18 at EL0)
+	ldr		x10, [x9, #32]						// SCTLR_EL1 as the kernels expect it (EnIA/EnDA back on)
+	msr		SCTLR_EL1, x10
+	isb
+	mov		x0, sp
+	mov		x29, xzr
+	bl		EXT(linux64_el0_exception)
+	b		.
