+
+#if PRECISE_USER_KERNEL_TIME
+	recount_leave_user();		/* interrupts are still off here, as on locore's exception entry */
+#endif
+	linux64_count(LINUX64_CTR_EL0_EXC);	/* for the host's monitor: EL0 exceptions, the last one's ESR, FAR, PC */
+	{
+		unsigned int slot = (unsigned int)cpu_number() & (LINUX64_EL0_CPUS - 1), ec = (unsigned int)ESR_EC(f->esr);
+		unsigned int cls = f->esr == ~0ULL ? 3 : ec == ESR_EC_SVC_64 ? 0 : ec == ESR_EC_DABORT_EL0 ? 1 : ec == ESR_EC_IABORT_EL0 ? 2 : 4;
+		linux64_el0_stat[slot][0][cls]++;
+		linux64_el0_cls[slot] = (uint8_t)cls;
+		linux64_el0_t0[slot] = __builtin_arm_rsr64("CNTVCT_EL0");
+	}
+	linux64_dbg[LINUX64_CTR_EL0_ESR] = f->esr;
+	linux64_dbg[LINUX64_CTR_EL0_FAR] = f->far;
+	linux64_dbg[LINUX64_CTR_EL0_PC] = f->pc;
+	if (linux64_tracing()) kprintf("linux64: EL0 exception esr 0x%llx far 0x%llx pc 0x%llx x16 %lld ttbr0 0x%llx ttep 0x%llx\n", f->esr, f->far, f->pc, f->x[16],
+	    __builtin_arm_rsr64("TTBR0_EL1"), (uint64_t)thread->map->pmap->ttep);
+	/*
+	 * The whole user state at once, signed once as locore's exception entry does (HAS_APPLE_PAC): the per-field setters
+	 * each check the old signature and sign again, five times per exception. EL0 runs with IRQ/FIQ masked while hosted
+	 * (no XNU interrupts at EL0 yet); XNU must see the user's own PSTATE, or its abort path takes the user fault for
+	 * one from a non-interruptible context.
+	 */
+	{
+		arm_saved_state64_t *s64 = saved_state64(ss);
+		uint32_t cpsr = (uint32_t)f->cpsr & ~(uint32_t)0x3c0;
+		for (unsigned i = 0; i < 29; i++) {
+			if (i != 16 && i != 17) {
+				s64->x[i] = f->x[i];
+			}
+		}
+		s64->fp = f->x[29];
+		s64->sp = f->sp;
+#if HAS_APPLE_PAC
+		uint64_t intr = ml_pac_safe_interrupts_disable();
+		asm volatile (
+			"mov	x9, lr"				"\n"
+			"mov	x0, %[ss]"			"\n"
+			"mrs	x10, SPSel"			"\n"
+			"msr	SPSel, #1"			"\n"
+			"mov	x1, %[pc]"			"\n"
+			"mov	w2, %w[cpsr]"			"\n"
+			"mov	x3, %[lr]"			"\n"
+			"mov	x4, %[x16]"			"\n"
+			"mov	x5, %[x17]"			"\n"
+			"str	x1, [x0, %[SS64_PC]]"		"\n"
+			"str	w2, [x0, %[SS64_CPSR]]"		"\n"
+			"str	x3, [x0, %[SS64_LR]]"		"\n"
+			"stp	x4, x5, [x0, %[SS64_X16]]"	"\n"
+			"bl	_ml_sign_thread_state"		"\n"
+			"msr	SPSel, x10"			"\n"
+			"mov	lr, x9"				"\n"
+			:
+			: [ss] "r"(ss), [pc] "r"(f->pc), [cpsr] "r"(cpsr), [lr] "r"(f->x[30]), [x16] "r"(f->x[16]), [x17] "r"(f->x[17]),
+			  [SS64_X16] "i"(ss64_offsetof(x[16])), [SS64_PC] "i"(ss64_offsetof(pc)),
+			  [SS64_CPSR] "i"(ss64_offsetof(cpsr)), [SS64_LR] "i"(ss64_offsetof(lr))
+			: "x0", "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x16", "x17", "memory"
+		);
+		ml_pac_safe_interrupts_restore(intr);
+#else
+		s64->x[16] = f->x[16];
+		s64->x[17] = f->x[17];
+		s64->lr = f->x[30];
+		s64->pc = f->pc;
+		s64->cpsr = cpsr;
+#endif
+	}
+	{
+		arm_neon_saved_state_t *ns = thread->machine.uNeon;
+		memcpy(&ns->ns_64.v.q[0], f->neon, sizeof(f->neon));
+		ns->ns_64.fpsr = f->fpsr;
+		ns->ns_64.fpcr = f->fpcr;
+	}
+	if (f->esr == ~0ULL) {
+		/*
+		 * A host IRQ arrived while user code ran (EL0 runs with IRQs unmasked). Let Linux take it and run what it
+		 * must (its tick, RCU, other tasks), then deliver XNU's timer "interrupt" if it is due, as sleh_irq
+		 * would: the quantum expiry it may raise preempts this thread on the way back to user space.
+		 */
+		cpu_data_t *cdp = getCpuDatap();
+		(void)ml_set_interrupts_enabled(FALSE);	/* XNU's (virtual) interrupt state: off, as in sleh_irq */
+		linux64_call2(LINUX64_CALL_PREEMPTED, 0, 0);
+		if (cdp->rtcPop != EndOfAllTime && cdp->rtcPop != 0 && mach_absolute_time() >= cdp->rtcPop) {
+			cdp->cpu_int_state = ss;
+			cdp->cpu_stat.irq_ex_cnt++;
+			cdp->cpu_decrementer = -1;
+			rtclock_intr(TRUE);
+			cdp->cpu_int_state = NULL;
+		}
+		if (os_atomic_load(&linux64_ipi_pending[linux64_cpu_slot()], relaxed)) {	/* another CPU's IPI, as sleh_fiq takes it */
+			cdp->cpu_int_state = ss;
+			linux64_ipi_take();
+			cdp->cpu_int_state = NULL;
+		}
+		thread_exception_return();
+	}
+	if (ESR_EC(f->esr) == ESR_EC_SVC_64 && linux64_tracing()) {
+		long long num = (long long)f->x[16];
+		linux64_svc_thread = thread;
+		linux64_svc_num = num;
+		if (num == 202 && f->x[1] > 0 && f->x[1] <= 8) {	/* sysctl: the MIB and this thread's kernel stack */
+			int mib[8] = {0};
+			if (copyin((user_addr_t)f->x[0], mib, f->x[1] * sizeof(int)) == 0) {
+				kprintf("linux64: svc 202 mib %d.%d.%d.%d (len %llu) kstack 0x%llx\n", mib[0], mib[1], mib[2], mib[3], f->x[1],
+				    (uint64_t)thread->kernel_stack);
+			}
+		}
+		if (num == 59 || num == 244 || num == 5 || num == 398 || num == 463 || num == 33 || num == 338 || num == 340 || num == 466 || num == 469) {
+			char path[128];
+			size_t len = 0;
+			uint64_t ua = (num == 463 || num == 466 || num == 469 || num == 244) ? f->x[1] : f->x[0];
+			if (copyinstr((user_addr_t)ua, path, sizeof(path), &len) == 0) {
+				extern int proc_selfpid(void);
+				kprintf("linux64: [%d] svc %lld path \"%s\"\n", proc_selfpid(), num, path);
+			}
+		}
+	}
+	sleh_synchronous(thread->machine.contextData, (uint32_t)f->esr, (vm_offset_t)f->far);
+	thread_exception_return();
+}
