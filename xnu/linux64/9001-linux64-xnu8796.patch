+		if (err) {
+			buf_seterror(bp, err);
+		} else {
+			buf_setresid(bp, 0);
+		}
+		buf_biodone(bp);
+		return;
+	}
+
 	fvaddr = (mdev[devid].mdBase << 12) + blkoff;           /* Point to offset into ram disk */
 
 	if (buf_flags(bp) & B_READ) {                                   /* Is this a read? */
@@ -439,7 +512,7 @@ mdevioctl(dev_t dev, u_long cmd, caddr_t data, __unused int flag,
 		if (!(mdev[devid].mdFlags & mdInited)) {
 			return ENXIO;
 		}
-		*o = ((mdev[devid].mdSize << 12) + mdev[devid].mdSecsize - 1) / mdev[devid].mdSecsize;
+		*o = (((uint64_t)mdev[devid].mdSize << 12) + mdev[devid].mdSecsize - 1) / mdev[devid].mdSecsize;
 		break;
 
 	/*
@@ -713,6 +786,37 @@ mdevadd(int devid, uint64_t base, unsigned int size, int phys)
 }
 
 
+/* LINUX64 (xnulinux): add the host-file disk (if the host has one) as the first free md unit. */
+dev_t
+mdevadd_host(void)
+{
+	uint64_t size = 0;
+	long bytes;
+	dev_t dev;
+	int i;
+
+	if (!linux64_hook) {
+		return -1;
+	}
+	mdev_host_call(995, (unsigned long)&size);
+	bytes = (long)size;
+	if (bytes < 4096) {
+		return -1;
+	}
+	/* a page-number range no RAM disk can overlap: the host disk has no memory behind it */
+	dev = mdevadd(-1, 1ULL << 40, (unsigned int)((uint64_t)bytes >> 12), 0);
+	if (dev == (dev_t)-1) {
+		return dev;
+	}
+	for (i = 0; i < NB_MAX_MDEVICES; i++) {
+		if ((mdev[i].mdFlags & mdInited) && mdev[i].mdBDev == dev) {
+			mdev[i].mdFlags |= mdHost;
+		}
+	}
+	printf("LINUX64: md%x is the host disk (%ld bytes)\n", minor(dev), bytes);
+	return dev;
+}
+
